function Elements:Keybind(opts)
	opts=opts or {}
	local flag=FlagOf(opts)
	local key=opts.Default
	local row=New("Frame",{Size=UDim2.new(1,0,0,22),BackgroundTransparency=1,Parent=self.Container})
	local name=Label(row,opts.Text or "keybind",(LabelColor(opts,Theme.Text)))
	name.Size=UDim2.new(1,-80,1,0)
	local pill=New("TextButton",{Size=UDim2.new(0,0,0,20),AutomaticSize=Enum.AutomaticSize.X,AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,0,0.5,0),BackgroundColor3=Theme.Field,AutoButtonColor=false,Text="",BorderSizePixel=0,Parent=row})
	Corner(pill,4)
	Stroke(pill,Theme.Border)
	Pad(pill,0,8)
	local pl=Label(pill,"",Theme.TextDim,12)
	pl.Size=UDim2.new(0,0,1,0)
	pl.AutomaticSize=Enum.AutomaticSize.X
	local api
	local listening=false
	local held=false
	local active=opts.Default==true
	local mode=string.lower(opts.Mode or "press")
	local isToggle=mode=="toggle"
	local function refresh()
		if listening then pl.Text='key: <font color="'..AccentHex()..'">...</font>'
		elseif key then pl.Text='key: <font color="'..AccentHex()..'">'..key.."</font>"
		else pl.Text="key: NONE" end
	end
	refresh()
	local function apply()
		if flag then Library.Flags[flag]=key or "" Library:MarkDirty(flag) end
		Library:RefreshHotkeys()
		Library:SafeCallback(opts.Text or "keybind",opts.OnChanged,key)
	end
	Track(pill.Activated:Connect(function()
		if api and api.Enabled==false then return end
		listening=true
		Library.Binding=true
		refresh()
		Tween(pill,{BackgroundColor3=Theme.FieldHover},EASE_FAST)
	end))
	Track(pill.MouseButton2Click:Connect(function()
		key=nil
		listening=false
		Library.Binding=false
		refresh()
		apply()
	end))
	Track(UserInputService.InputBegan:Connect(function(input,gpe)
		local n=KeyName(input)
		if listening then
			if input.UserInputType==Enum.UserInputType.MouseButton1 then
				listening=false
				Library.Binding=false
				refresh()
				Tween(pill,{BackgroundColor3=Theme.Field},EASE_FAST)
				return
			end
			if input.KeyCode==Enum.KeyCode.Escape then key=nil
			elseif n then key=n
			else return end
			listening=false
			Library.Binding=false
			refresh()
			Tween(pill,{BackgroundColor3=Theme.Field},EASE_FAST)
			apply()
			return
		end
		if gpe or not key or n~=key then return end
		if api and api.Enabled==false then return end
		if isToggle then
			active=not active
			if api then api.Active=active end
			Library:RefreshHotkeys()
			Library:SafeCallback(opts.Text or "keybind",opts.Callback,active)
		else
			held=true
			Library:RefreshHotkeys()
			Library:SafeCallback(opts.Text or "keybind",opts.Callback,true)
		end
	end))
	Track(UserInputService.InputEnded:Connect(function(input)
		if isToggle or not held then return end
		if key and KeyName(input)==key then
			held=false
			Library:RefreshHotkeys()
			Library:SafeCallback(opts.Text or "keybind",opts.Callback,false)
		end
	end))
	api={Instance=row,Active=active,Get=function() return key or "" end,Set=function(_,k) key=(k~="" and k) or nil refresh() apply() end}
	Disableable(api,{name,pl},opts)
	Library:RegisterHotkey(function()
		return {Label=opts.Text or "keybind",Key=key,Active=isToggle and active or held,Visible=key~=nil and (isToggle or held)}
	end)
	Library:OnRepaint(refresh)
	if flag then
		Library.Flags[flag]=key or ""
		Library:Register(flag,{Type="Keybind",Get=function() return key or "" end,Set=function(v) api:Set(v) end})
	end
	if key then apply() end
	return api
end


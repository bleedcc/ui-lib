	local img=New("ImageLabel",{Size=UDim2.fromOffset(size,size),Position=UDim2.fromOffset(0,1),BackgroundTransparency=1,Image=r.Image,ImageColor3=color,Parent=p})
	if r.RectOffset then img.ImageRectOffset=r.RectOffset end
	if r.RectSize then img.ImageRectSize=r.RectSize end
	return img
end

function Elements:Label(text,opts)
	if typeof(opts)=="Color3" then opts={Color=opts} end
	opts=opts or {}
	local color=opts.Color or StyleColor(opts.Style,Theme.TextDim)
	local row=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=self.Container})
	local icon=AttachIcon(row,opts.Icon,color,14)
	local inset=icon and 20 or 0
	local l=Label(row,tostring(text or ""),color,opts.TextSize,opts.Font)
	l.Position=UDim2.fromOffset(inset,0)
	l.Size=UDim2.new(1,-inset,0,0)
	l.AutomaticSize=Enum.AutomaticSize.Y
	l.TextWrapped=true
	l.TextYAlignment=Enum.TextYAlignment.Top
	local api={Instance=row,Text=l,Icon=icon}
	local function sync() if not opts.KeepSpace then row.Visible=l.Text~="" end end
	function api:Set(v) l.Text=tostring(v or "") sync() end
	function api:SetColor(c) l.TextColor3=c if icon then icon.ImageColor3=c end end
	function api:SetStyle(s) api:SetColor(StyleColor(s,Theme.TextDim)) end
	sync()
	return api
end

function Elements:Paragraph(opts)
	opts=opts or {}
	local accent=StyleColor(opts.Style,Theme.TextBright)
	local styled=type(opts.Style)=="string" and string.lower(opts.Style)~="normal"
	local card=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=Theme.Group,BorderSizePixel=0,Parent=self.Container})
	Corner(card,5)
	local stroke=Stroke(card,styled and accent or Theme.GroupBorder,1,styled and 0.55 or 0)
	Pad(card,9,11)
	local inner=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=card})
	List(inner,4)
	local head=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=inner})
	local icon=AttachIcon(head,opts.Icon,accent,15)
	local inset=icon and 21 or 0
	local title=Label(head,opts.Title or "",accent,Theme.TextSize,Theme.FontMedium)
	title.Position=UDim2.fromOffset(inset,0)
	title.Size=UDim2.new(1,-inset,0,0)
	title.AutomaticSize=Enum.AutomaticSize.Y
	title.TextWrapped=true
	title.TextYAlignment=Enum.TextYAlignment.Top
	local body
	if opts.Content then
		body=Label(inner,opts.Content,opts.ContentColor or Theme.TextDim,opts.TextSize or 12)
		body.Size=UDim2.new(1,0,0,0)
		body.AutomaticSize=Enum.AutomaticSize.Y
		body.TextWrapped=true
		body.TextYAlignment=Enum.TextYAlignment.Top
		body.LayoutOrder=2
	end
	local api={Instance=card,Title=title,Body=body,Icon=icon}
	function api:Set(o)
		o=o or {}
		if o.Title then title.Text=o.Title end
		if o.Content and body then body.Text=o.Content end
		if o.Style then
			local c=StyleColor(o.Style,Theme.TextBright)
			title.TextColor3=c
			if icon then icon.ImageColor3=c end
			stroke.Color=c
		end
	end
	return api
end

local function MakeButton(parent,opts,size,order)
	local state={Enabled=true}
	local btn=New("TextButton",{Size=size or UDim2.new(1,0,0,26),BackgroundColor3=Theme.Field,AutoButtonColor=false,Text="",BorderSizePixel=0,LayoutOrder=order,Parent=parent})
	Corner(btn,5)
	Stroke(btn,Theme.Border)
	local text=Label(btn,opts.Text or "button",(LabelColor(opts,Theme.TextBright)))
	text.Size=UDim2.fromScale(1,1)
	text.TextXAlignment=Enum.TextXAlignment.Center
	text.TextTruncate=Enum.TextTruncate.AtEnd
	Hover(btn,btn,"Field","FieldHover")
	Track(btn.Activated:Connect(function()
		if state.Enabled==false then return end
		Library:SafeCallback(opts.Text or "button",opts.Callback)
	end))
	return btn,state,text
end

function Elements:Button(opts)
	opts=opts or {}
	local btn,state,text=MakeButton(self.Container,opts)

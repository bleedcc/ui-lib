function Library:SafeCallback(label,callback,...)
	if not callback then return end
	local packed=table.pack(...)
	task.spawn(function()
		local ok,err=pcall(callback,table.unpack(packed,1,packed.n))
		if ok then return end
		local msg=tostring(err)
		local _,cut=string.find(msg,":%d+: ")
		if cut then msg=string.sub(msg,cut+1) end
		warn("Facility | callback error in '"..tostring(label).."': "..tostring(err))
		if Library.Error then Library:Error("callback error",tostring(label).." - "..msg,7) end
	end)
end

function Library:OnRepaint(cb) table.insert(self.RepaintHooks,cb) return cb end

function Library:LoadAddon(name)
	if self.Addons[name]~=nil then return self.Addons[name] end
	local module
	local ok,found=pcall(function()
		local root=script and script.Parent
		local folder=root and (root:FindFirstChild("addons") or root:FindFirstChild("Addons"))
		local file=folder and folder:FindFirstChild(name)
		return file and require(file) or nil
	end)
	if ok then module=found end
	if module==nil then
		local path=self.AddonPaths[name]
		if not path then return nil end
		local fetched,src=pcall(function() return game:HttpGet(self.BaseUrl..path) end)
		if fetched and type(src)=="string" and #src>0 then
			local built,chk=pcall(loadstring,src)
			if built and type(chk)=="function" then
				local ran,val=pcall(chk)
				if ran then module=val end
			end
		end
	end
	if module==nil then return nil end
	if type(module)=="function" then module=module(self) end
	self.Addons[name]=module
	return module
end

function Library:SetColor(key,color,alpha)
	if type(key)=="string" then
		local lower=string.lower(key)
		for _,k in ipairs(THEME_ORDER) do if string.lower(k)==lower then key=k break end end
	end
	if typeof(color)~="Color3" or Theme[key]==nil then return false end
	Theme[key]=color
	if alpha~=nil then ThemeAlpha[key]=math.clamp(alpha,0,1) end
	self:Repaint()
	for i=#self.ThemeChanged,1,-1 do
		local ok=pcall(self.ThemeChanged[i],key,color,ThemeAlpha[key])
		if not ok then table.remove(self.ThemeChanged,i) end
	end
	return true
end

local function ResolveThemeKey(key)
	if type(key)~="string" then return nil end
	local lower=string.lower(key)
	for _,k in ipairs(THEME_ORDER) do if string.lower(k)==lower then return k end end
	return nil
end

local function ParseHex(input)
	if typeof(input)=="Color3" then return input end
	if type(input)~="string" then return nil end
	local h=string.gsub(string.gsub(input,"#",""),"%s","")
	if #h~=6 and #h~=8 then return nil end
	local r=tonumber(string.sub(h,1,2),16) local g=tonumber(string.sub(h,3,4),16) local b=tonumber(string.sub(h,5,6),16)
	if not r or not g or not b then return nil end
	return Color3.fromRGB(r,g,b)
end

function Library:GetColor(key) local k=ResolveThemeKey(key) if not k then return nil end return Theme[k],ThemeAlpha[k] or 1 end
function Library:GetTheme() local out={} for k,v in pairs(Theme) do if typeof(v)=="Color3" then out[k]=v end end return out end

function Library:SetTheme(tbl)
	if type(tbl)~="table" then return false end
	local any=false
	for key,val in pairs(tbl) do
		local k=ResolveThemeKey(key)
		if k then local c=ParseHex(val) if c then Theme[k]=c any=true end end
	end
	if any then
		self:Repaint()
		for i=#self.ThemeChanged,1,-1 do
			local ok=pcall(self.ThemeChanged[i],nil,nil,nil)
			if not ok then table.remove(self.ThemeChanged,i) end
		end
	end
	return any
end

function Library:ResetTheme() return self:SetTheme(Library.DefaultTheme) end
function Library:OnThemeChanged(cb) if type(cb)~="function" then return nil end table.insert(self.ThemeChanged,cb) return cb end
function Library:OffThemeChanged(cb) for i=#self.ThemeChanged,1,-1 do if self.ThemeChanged[i]==cb then table.remove(self.ThemeChanged,i) end end end


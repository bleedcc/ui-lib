	Corner(hueCursor,2)
	local alphaBar,alphaCursor,alphaGradient
	if useAlpha then
		local track=New("Frame",{Size=UDim2.new(1,0,0,10),BackgroundColor3=Theme.Track,BorderSizePixel=0,LayoutOrder=2,ZIndex=z,Parent=panel.Content})
		Corner(track,3)
		alphaBar=New("TextButton",{Size=UDim2.fromScale(1,1),BackgroundColor3=base,AutoButtonColor=false,Text="",BorderSizePixel=0,ZIndex=z,Parent=track})
		Corner(alphaBar,3)
		alphaGradient=New("UIGradient",{Color=ColorSequence.new(base),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}),Parent=alphaBar})
		alphaCursor=New("Frame",{Size=UDim2.new(0,3,1,4),AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(1,0,0.5,0),BackgroundColor3=Color3.fromRGB(255,255,255),BorderSizePixel=0,ZIndex=z+1,Parent=alphaBar})
		Corner(alphaCursor,2)
	end
	local hexField=New("Frame",{Size=UDim2.new(1,0,0,24),BackgroundColor3=Theme.Field,BorderSizePixel=0,LayoutOrder=3,ZIndex=z,Parent=panel.Content})
	Corner(hexField,4)
	local hexStroke=Stroke(hexField,Theme.Border)
	local hexBox=New("TextBox",{Size=UDim2.new(1,-16,1,0),Position=UDim2.fromOffset(8,0),BackgroundTransparency=1,Text=ToHex(base,alpha),TextColor3=Theme.TextBright,TextSize=12,Font=Theme.Font,TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false,ZIndex=z,Parent=hexField})
	local api={Instance=swatch,Swatch=swatch,Color=base,Alpha=alpha}
	local editing=false
	local function current() return Color3.fromHSV(hue,sat,val) end
	local function render()
		local color=current()
		api.Color=color
		api.Alpha=alpha
		sv.BackgroundColor3=Color3.fromHSV(hue,1,1)
		svCursor.Position=UDim2.fromScale(sat,1-val)
		hueCursor.Position=UDim2.new(0.5,0,hue,0)
		swatch.BackgroundColor3=color
		swatch.BackgroundTransparency=useAlpha and (1-alpha)*0.75 or 0
		if alphaGradient then alphaGradient.Color=ColorSequence.new(color) alphaCursor.Position=UDim2.new(alpha,0,0.5,0) end
		if not editing then hexBox.Text=ToHex(color,alpha) end
		if flag then Library.Flags[flag]=ToHex(color,alpha) Library:MarkDirty(flag) end
	end
	local function fire() Library:SafeCallback(opts.Text or "color picker",opts.Callback,current(),alpha) end
	function api:Set(color,newAlpha,silent)
		local parsed,pa=FromHex(color)
		if parsed then color=parsed newAlpha=newAlpha or pa end
		if typeof(color)=="Color3" then hue,sat,val=color:ToHSV() end
		if newAlpha then alpha=math.clamp(newAlpha,0,1) end
		render()
		if not silent then fire() end
	end
	function api:Get() return current(),alpha end
	BindDrag(sv,function(pos)
		sat=math.clamp((pos.X-sv.AbsolutePosition.X)/math.max(sv.AbsoluteSize.X,1),0,1)
		val=1-math.clamp((pos.Y-sv.AbsolutePosition.Y)/math.max(sv.AbsoluteSize.Y,1),0,1)
		render()
		fire()
	end)
	BindDrag(hueBar,function(pos)
		hue=math.clamp((pos.Y-hueBar.AbsolutePosition.Y)/math.max(hueBar.AbsoluteSize.Y,1),0,1)
		render()
		fire()
	end)
	if alphaBar then
		BindDrag(alphaBar,function(pos)
			alpha=math.clamp((pos.X-alphaBar.AbsolutePosition.X)/math.max(alphaBar.AbsoluteSize.X,1),0,1)
			render()
			fire()
		end)
	end
	Track(hexBox.Focused:Connect(function() editing=true Tween(hexStroke,{Color=Theme.Accent},EASE_FAST) end))
	Track(hexBox.FocusLost:Connect(function()
		editing=false
		Tween(hexStroke,{Color=Theme.Border},EASE_FAST)
		local parsed,pa=FromHex(hexBox.Text)
		if parsed then api:Set(parsed,pa) else render() end
	end))
	Track(swatch.Activated:Connect(function()
		if api.Enabled==false then return end
		owner.Window:ToggleFloating(panel,swatch)
	end))
	Disableable(api,{},opts)
	Library:OnRepaint(render)
	if flag then
		Library.Flags[flag]=ToHex(base,alpha)
		Library:Register(flag,{Type="ColorPicker",Get=function() return ToHex(current(),alpha) end,Set=function(v) api:Set(v) end})
	end
	render()
	return api
end


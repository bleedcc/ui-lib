function Elements:Toggle(opts)
	opts=opts or {}
	local flag=FlagOf(opts)
	local state=opts.Default==true
	local row=New("Frame",{Size=UDim2.new(1,0,0,22),BackgroundTransparency=1,Parent=self.Container})
	local hit=New("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",AutoButtonColor=false,Parent=row})
	local box=New("Frame",{Size=UDim2.fromOffset(13,13),AnchorPoint=Vector2.new(0,0.5),Position=UDim2.new(0,0,0.5,0),BackgroundColor3=Theme.Accent,BackgroundTransparency=1,BorderSizePixel=0,Parent=row})
	Corner(box,3)
	local boxStroke=Stroke(box,Theme.Border)
	local labelColor,customLabel=LabelColor(opts,Theme.Text)
	local text=Label(row,opts.Text or "toggle",labelColor)
	text.Position=UDim2.fromOffset(21,0)
	text.Size=UDim2.new(1,-21,1,0)
	local left=New("Frame",{Size=UDim2.new(1,-21,1,0),Position=UDim2.fromOffset(21,0),BackgroundTransparency=1,Parent=row})
	local leftList=List(left,6,Enum.FillDirection.Horizontal)
	leftList.VerticalAlignment=Enum.VerticalAlignment.Center
	text.Parent=left
	text.Size=UDim2.fromOffset(0,18)
	text.AutomaticSize=Enum.AutomaticSize.X
	text.Position=UDim2.fromOffset(0,0)
	text.LayoutOrder=1
	if opts.Hint then MakeHint(self,left,opts.Hint,2) end
	local right=New("Frame",{Size=UDim2.new(0,0,1,0),AnchorPoint=Vector2.new(1,0),Position=UDim2.fromScale(1,0),AutomaticSize=Enum.AutomaticSize.X,BackgroundTransparency=1,Parent=row})
	local rightList=List(right,8,Enum.FillDirection.Horizontal)
	rightList.VerticalAlignment=Enum.VerticalAlignment.Center
	rightList.HorizontalAlignment=Enum.HorizontalAlignment.Right
	local owner=self
	local function syncRow()
		local s=math.max(owner.Window.Scale.Scale,0.05)
		local w=right.AbsoluteSize.X/s
		left.Size=UDim2.new(1,-(21+(w>0 and w+10 or 0)),1,0)
	end
	Track(right:GetPropertyChangedSignal("AbsoluteSize"):Connect(syncRow))
	syncRow()
	local pickerCount=0
	local api={Instance=row,State=state,Pickers={}}
	local function render(animate)
		local info=animate and EASE_FAST or TweenInfo.new(0)
		Tween(box,{BackgroundTransparency=state and 0 or 1},info)
		Tween(boxStroke,{Color=state and Theme.Accent or Theme.Border},info)
	end
	function api:Set(v,silent)
		state=v and true or false
		api.State=state
		if flag then Library.Flags[flag]=state Library:MarkDirty(flag) end
		render(true)
		Library:RefreshHotkeys()
		if not silent then Library:SafeCallback(opts.Text or "toggle",opts.Callback,state) end
	end
	Track(hit.Activated:Connect(function()
		if api.Enabled==false then return end
		api:Set(not state)
	end))
	Track(hit.MouseEnter:Connect(function()
		if customLabel then return end
		Tween(text,{TextColor3=Theme.TextBright},EASE_FAST)
	end))
	Track(hit.MouseLeave:Connect(function()
		if customLabel then return end
		Tween(text,{TextColor3=Theme.Text},EASE_FAST)
	end))
	function api:Keybind(bindOpts)
		bindOpts=bindOpts or {}
		local key=bindOpts.Default
		local pill=New("TextButton",{Size=UDim2.new(0,0,0,20),AutomaticSize=Enum.AutomaticSize.X,BackgroundColor3=Theme.Field,AutoButtonColor=false,Text="",BorderSizePixel=0,LayoutOrder=20,Parent=right})
		Corner(pill,4)
		Stroke(pill,Theme.Border)
		local pl=Label(pill,"",Theme.TextDim,12)
		pl.Size=UDim2.new(0,0,1,0)
		pl.AutomaticSize=Enum.AutomaticSize.X
		Pad(pill,0,8)
		local bf=bindOpts.Flag
		local listening=false
		local function refresh()
			if listening then pl.Text='key: <font color="'..AccentHex()..'">...</font>'
			elseif key then pl.Text='key: <font color="'..AccentHex()..'">'..key.."</font>"
			else pl.Text="key: NONE" end
			if bf then Library.Flags[bf]=key or "" Library:MarkDirty(bf) end
			Library:RefreshHotkeys()
		end
		refresh()
		Library:RegisterHotkey(function()
			return {Label=opts.Text or "toggle",Key=key,Active=state,Visible=key~=nil}
		end)
		Library:OnRepaint(refresh)
		if bf then
			Library:Register(bf,{Type="Keybind",Get=function() return key or "" end,Set=function(v) key=(v~="" and v) or nil listening=false refresh() end})
		end
		Track(pill.Activated:Connect(function()
			listening=true
			Library.Binding=true
			refresh()
			Tween(pill,{BackgroundColor3=Theme.FieldHover},EASE_FAST)
		end))
		Track(pill.MouseButton2Click:Connect(function()
			key=nil
			listening=false
			Library.Binding=false
			refresh()
		end))
		Track(UserInputService.InputBegan:Connect(function(input,gpe)
			local name=KeyName(input)
			if listening then
				if input.UserInputType==Enum.UserInputType.MouseButton1 then
					listening=false
					Library.Binding=false
					Tween(pill,{BackgroundColor3=Theme.Field},EASE_FAST)
					refresh()
					return
				end
				if input.KeyCode==Enum.KeyCode.Escape then key=nil
				elseif name then key=name
				else return end
				listening=false
				Library.Binding=false
				refresh()
				Tween(pill,{BackgroundColor3=Theme.Field},EASE_FAST)
				return
			end
			if gpe or not key or name~=key then return end
			if bindOpts.Mode=="hold" then return end
			api:Set(not state)
		end))
		if bindOpts.Mode=="hold" then
			Track(UserInputService.InputEnded:Connect(function(input)
				if key and KeyName(input)==key then api:Set(false) end
			end))
			Track(UserInputService.InputBegan:Connect(function(input,gpe)
				if not gpe and key and KeyName(input)==key then api:Set(true) end
			end))
		end
		return api
	end
	function api:ColorPicker(pickerOpts)
		pickerOpts=pickerOpts or {}
		pickerCount=pickerCount+1
		local swatch=ColorSwatch(right,{Size=UDim2.fromOffset(24,13),BackgroundColor3=pickerOpts.Default or Color3.fromRGB(255,255,255),AutoButtonColor=false,Text="",BorderSizePixel=0,LayoutOrder=pickerCount,Parent=right})
		local picker=BuildColorPicker(owner,swatch,pickerOpts)
		api.Pickers[pickerCount]=picker
		return api
	end
	function api:Gear(builder)
		local gear=New("ImageButton",{Size=UDim2.fromOffset(14,14),BackgroundTransparency=1,Image=Theme.GearIcon,ImageColor3=Theme.TextDim,LayoutOrder=30,Parent=right})
		local panel=owner.Window:CreateFloating(190,false,owner.Float)
		local content=NewContainer(owner.Window,panel.Content,panel)
		if builder then builder(content) end
		Track(gear.MouseEnter:Connect(function() Tween(gear,{ImageColor3=Theme.TextBright},EASE_FAST) end))
		Track(gear.MouseLeave:Connect(function() Tween(gear,{ImageColor3=Theme.TextDim},EASE_FAST) end))
		Track(gear.Activated:Connect(function() owner.Window:ToggleFloating(panel,gear) end))
		return api
	end
	Disableable(api,{text,boxStroke},opts)
	Library:OnRepaint(function() render(false) end)
	if flag then
		Library.Flags[flag]=state
		Library:Register(flag,{Type="Toggle",Get=function() return state end,Set=function(v) api:Set(v==true) end})
	end
	render(false)
	if state then Library:SafeCallback(opts.Text or "toggle",opts.Callback,state) end
	return api
end

function Elements:Dropdown(opts)
	opts=opts or {}
	local flag=FlagOf(opts)
	local values=opts.Options or {}
	local multi=opts.Multi==true
	local selected=multi and (opts.Default or {}) or opts.Default or values[1]
	local block=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=self.Container})
	List(block,5)
	local caption
	if opts.Text then
		caption=Label(block,opts.Text,(LabelColor(opts,Theme.Text)))
		caption.Size=UDim2.new(1,0,0,15)
	end
	local button=New("TextButton",{Size=UDim2.new(1,0,0,26),BackgroundColor3=Theme.Field,AutoButtonColor=false,Text="",BorderSizePixel=0,LayoutOrder=2,Parent=block})
	Corner(button,5)
	local bStroke=Stroke(button,Theme.Border)
	local value=Label(button,"",Theme.TextBright)
	value.Position=UDim2.fromOffset(10,0)
	value.Size=UDim2.new(1,-34,1,0)
	value.TextTruncate=Enum.TextTruncate.AtEnd
	local chev=Chevron(button,Theme.Text)
	chev.AnchorPoint=Vector2.new(1,0.5)
	chev.Position=UDim2.new(1,-10,0.5,0)
	local panel=self.Window:CreateFloating(0,true,self.Float)
	local searchField=New("Frame",{Size=UDim2.new(1,0,0,24),BackgroundColor3=Theme.Field,BorderSizePixel=0,LayoutOrder=1,Visible=false,ZIndex=panel.Frame.ZIndex,Parent=panel.Content})
	Corner(searchField,4)
	Stroke(searchField,Theme.Border)
	local searchBox=New("TextBox",{Size=UDim2.new(1,-16,1,0),Position=UDim2.fromOffset(8,0),BackgroundTransparency=1,Text="",PlaceholderText="search",PlaceholderColor3=Theme.TextDim,TextColor3=Theme.TextBright,TextSize=12,Font=Theme.Font,TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false,ZIndex=panel.Frame.ZIndex,Parent=searchField})
	local scroller=New("ScrollingFrame",{Size=UDim2.new(1,0,0,24),AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),ScrollBarThickness=2,ScrollBarImageColor3=Theme.AccentDim,BackgroundTransparency=1,BorderSizePixel=0,LayoutOrder=2,ZIndex=panel.Frame.ZIndex,Parent=panel.Content})
	List(scroller,2)
	local api={Instance=block}
	local rows={}
	local function display()
		if multi then if #selected==0 then return opts.Empty or "none" end return table.concat(selected,", ") end
		return tostring(selected or opts.Empty or "none")
	end
	local function isPicked(v)
		if multi then for _,x in ipairs(selected) do if x==v then return true end end return false end
		return selected==v
	end
	local function refresh()
		value.Text=display()
		for v,row in pairs(rows) do
			local picked=isPicked(v)
			Tween(row.Text,{TextColor3=picked and Theme.AccentSoft or Theme.Text},EASE_FAST)
		end
		if flag then Library.Flags[flag]=selected Library:MarkDirty(flag) end
	end
	local function applyFilter()
		local q=searchField.Visible and string.lower(searchBox.Text) or ""
		local shown=0
		for _,v in ipairs(values) do
			local row=rows[v]
			if row then
				local vis=q=="" or string.find(string.lower(tostring(v)),q,1,true)~=nil
				row.Button.Visible=vis
				if vis then shown=shown+1 end
			end
		end
		scroller.Size=UDim2.new(1,0,0,math.min(math.max(shown,1)*26-2,opts.MaxHeight or 154))
	end
	local function build()
		for _,row in pairs(rows) do row.Button:Destroy() end
		searchField.Visible=opts.Search==true or (opts.Search~=false and #values>8)
		rows={}
		for i,v in ipairs(values) do
			local item=New("TextButton",{Size=UDim2.new(1,0,0,24),BackgroundColor3=Theme.FieldHover,BackgroundTransparency=1,AutoButtonColor=false,Text="",BorderSizePixel=0,LayoutOrder=i,ZIndex=panel.Frame.ZIndex,Parent=scroller})
			Corner(item,4)
			local il=Label(item,tostring(v),Theme.Text)
			il.Position=UDim2.fromOffset(8,0)
			il.Size=UDim2.new(1,-16,1,0)
			il.ZIndex=panel.Frame.ZIndex
			rows[v]={Button=item,Text=il}
			Track(item.MouseEnter:Connect(function() Tween(item,{BackgroundTransparency=0.4},EASE_FAST) end))
			Track(item.MouseLeave:Connect(function() Tween(item,{BackgroundTransparency=1},EASE_FAST) end))
			Track(item.Activated:Connect(function()
				if multi then
					local found
					for idx,x in ipairs(selected) do if x==v then found=idx break end end
					if found then table.remove(selected,found) else table.insert(selected,v) end
				else selected=v self.Window:CloseFloating() end
				refresh()
				Library:SafeCallback(opts.Text or "dropdown",opts.Callback,selected)
			end))
		end
		applyFilter()
	end
	Track(searchBox:GetPropertyChangedSignal("Text"):Connect(applyFilter))
	panel.OnOpen=function()
		searchBox.Text=""
		applyFilter()
		Tween(bStroke,{Color=Theme.Accent},EASE_FAST)
		Tween(chev,{Rotation=180},EASE_FAST)
	end
	panel.OnClose=function()
		Tween(bStroke,{Color=Theme.Border},EASE_FAST)
		Tween(chev,{Rotation=0},EASE_FAST)
	end
	Track(button.Activated:Connect(function()
		if api.Enabled==false then return end
		self.Window:ToggleFloating(panel,button,true)
	end))
	Hover(button,button,"Field","FieldHover")
	function api:Set(v,silent)
		selected=v
		refresh()
		if not silent then Library:SafeCallback(opts.Text or "dropdown",opts.Callback,selected) end
	end
	function api:Get() return selected end
	function api:SetOptions(newValues)
		values=newValues or {}
		build()
		if not multi and not isPicked(selected) then selected=values[1] end
		refresh()
	end
	build()
	refresh()
	Disableable(api,{value,caption},opts)
	Library:OnRepaint(function()
		refresh()
		local open=false
		for _,p in ipairs(self.Window.FloatStack) do if p==panel then open=true break end end
		bStroke.Color=open and Theme.Accent or Theme.Border
		for _,bar in ipairs(chev:GetChildren()) do if bar:IsA("Frame") then bar.BackgroundColor3=Theme.TextDim end end
	end)
	if flag then
		Library:Register(flag,{Type=multi and "MultiDropdown" or "Dropdown",
			Get=function()
				if not multi then return selected end
				local c={}
				for i,v in ipairs(selected) do c[i]=v end
				return c
			end,
			Set=function(v) if multi and type(v)~="table" then v={v} end api:Set(v) end})
	end
	return api
end

function Elements:Slider(opts)
	opts=opts or {}
	local flag=FlagOf(opts)
	local min=opts.Min or 0
	local max=opts.Max or 100
	local decimals=opts.Decimals or 0
	local value=math.clamp(opts.Default or min,min,max)
	local block=New("Frame",{Size=UDim2.new(1,0,0,30),BackgroundTransparency=1,Parent=self.Container})
	local head=New("Frame",{Size=UDim2.new(1,0,0,16),BackgroundTransparency=1,Parent=block})
	local headList=List(head,8,Enum.FillDirection.Horizontal)
	headList.VerticalAlignment=Enum.VerticalAlignment.Center
	local name=Label(head,opts.Text or "slider",(LabelColor(opts,Theme.Text)))
	name.Size=UDim2.fromOffset(0,16)
	name.AutomaticSize=Enum.AutomaticSize.X
	local valueLabel=Label(head,"",Theme.TextDim,12)
	valueLabel.Size=UDim2.fromOffset(0,16)
	valueLabel.AutomaticSize=Enum.AutomaticSize.X
	valueLabel.LayoutOrder=2
	local track=New("TextButton",{Size=UDim2.new(1,0,0,4),Position=UDim2.new(0,0,0,24),BackgroundColor3=Theme.Track,AutoButtonColor=false,Text="",BorderSizePixel=0,Parent=block})
	Corner(track,2)
	local fill=New("Frame",{Size=UDim2.fromScale(0,1),BackgroundColor3=Theme.Accent,BorderSizePixel=0,Parent=track})
	Corner(fill,2)
	local knob=New("Frame",{Size=UDim2.fromOffset(9,9),AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0,0.5),BackgroundColor3=Theme.Accent,BorderSizePixel=0,Parent=track})
	Corner(knob,5)
	local hit=New("TextButton",{Size=UDim2.new(1,0,0,15),Position=UDim2.new(0,0,0,16),BackgroundTransparency=1,AutoButtonColor=false,Text="",Parent=block})
	local api={Instance=block,Value=value}
	local function format(v)
		if opts.ZeroText and v==min then return opts.ZeroText end
		local s=decimals>0 and string.format("%."..decimals.."f",v) or tostring(math.floor(v+0.5))
		return s..(opts.Suffix or "")
	end
	local function render(v,animate)
		local a=(max-min)==0 and 0 or (v-min)/(max-min)
		local info=animate and EASE_FAST or TweenInfo.new(0)
		Tween(fill,{Size=UDim2.fromScale(a,1)},info)
		Tween(knob,{Position=UDim2.new(a,0,0.5,0)},info)
		valueLabel.Text=format(v)
	end
	function api:Set(v,silent)
		v=math.clamp(v,min,max)
		if opts.Step then v=min+math.floor((v-min)/opts.Step+0.5)*opts.Step end
		if decimals==0 then v=math.floor(v+0.5) end
		value=v
		api.Value=v
		if flag then Library.Flags[flag]=v Library:MarkDirty(flag) end
		render(v,true)
		if not silent then Library:SafeCallback(opts.Text or "slider",opts.Callback,v) end
	end
	local dragging,mc,ec
	local function fromX(x)
		local a=math.clamp((x-track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1),0,1)
		api:Set(min+(max-min)*a)
	end
	Track(hit.InputBegan:Connect(function(input)
		if api.Enabled==false then return end
		if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
		dragging=true
		Tween(knob,{Size=UDim2.fromOffset(11,11)},EASE_FAST)
		fromX(input.Position.X)
		mc=UserInputService.InputChanged:Connect(function(m)
			if m.UserInputType==Enum.UserInputType.MouseMovement or m.UserInputType==Enum.UserInputType.Touch then
				if dragging then fromX(m.Position.X) end
			end
		end)
		ec=UserInputService.InputEnded:Connect(function(e)
			if e.UserInputType==input.UserInputType then
				dragging=false
				Tween(knob,{Size=UDim2.fromOffset(9,9)},EASE_FAST)
				if mc then mc:Disconnect() mc=nil end
				if ec then ec:Disconnect() ec=nil end
			end
		end)
	end))
	Disableable(api,{name,valueLabel},opts)
	if flag then
		Library.Flags[flag]=value
		Library:Register(flag,{Type="Slider",Get=function() return value end,Set=function(v) api:Set(tonumber(v) or min) end})
	end
	render(value,false)
	return api
end

function BuildColorPicker(owner,swatch,opts)
	opts=opts or {}
	local flag=FlagOf(opts)
	local useAlpha=opts.Alpha~=false
	local base=opts.Default or Color3.fromRGB(255,255,255)
	local alpha=opts.DefaultAlpha or 1
	local hue,sat,val=base:ToHSV()
	local panel=owner.Window:CreateFloating(198,false,owner.Float)
	local z=panel.Frame.ZIndex
	local area=New("Frame",{Size=UDim2.new(1,0,0,106),BackgroundTransparency=1,ZIndex=z,Parent=panel.Content})

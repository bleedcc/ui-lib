local IconLib,IconTried
function Library:PreloadIcons()
	if IconTried then return IconLib end
	IconTried=true
	local l=self:LoadAddon("Icons")
	if type(l)=="table" then IconLib=l end
	return IconLib
end

local function ResolveIcon(icon)
	if not icon or icon==0 or icon=="" then return nil end
	if type(icon)=="number" then return {Image="rbxassetid://"..icon} end
	if type(icon)~="string" then return nil end
	if string.find(icon,"rbxassetid://")==1 or string.find(icon,"rbxasset://")==1 then return {Image=icon} end
	local lib=Library:PreloadIcons()
	local set=lib and lib["48px"]
	local entry=set and set[string.lower(string.match(icon,"^%s*(.-)%s*$"))]
	if not entry or type(entry[1])~="number" then return nil end
	return {Image="rbxassetid://"..entry[1],RectSize=Vector2.new(entry[2][1],entry[2][2]),RectOffset=Vector2.new(entry[3][1],entry[3][2])}
end

local function StyleColor(style,fallback)
	if typeof(style)=="Color3" then return style end
	if type(style)~="string" then return fallback end
	local s=string.lower(style)
	if s=="normal" or s=="text" then return Theme.Text end
	if s=="dim" or s=="muted" then return Theme.TextDim end
	if s=="bright" or s=="title" then return Theme.TextBright end
	if s=="warning" or s=="warn" or s=="yellow" then return Theme.TextMarked end
	if s=="danger" or s=="error" or s=="red" then return Theme.Danger end
	if s=="success" or s=="green" then return Theme.TextCode end
	if s=="accent" or s=="pink" then return Theme.Accent end
	return fallback
end

local function Disableable(api,parts,opts)
	api.Enabled=true
	function api:SetEnabled(state)
		state=state~=false
		self.Enabled=state
		for _,inst in ipairs(parts) do
			pcall(function()
				if inst:IsA("UIStroke") then inst.Transparency=state and 0 or 0.7
				elseif inst:IsA("ImageLabel") or inst:IsA("ImageButton") then inst.ImageTransparency=state and 0 or 0.6
				else inst.TextTransparency=state and 0 or 0.6 if inst:IsA("TextBox") then inst.TextEditable=state end end
			end)
		end
		return self
	end
	function api:SetDisabled(state) return self:SetEnabled(not state) end
	if opts and opts.Disabled then api:SetEnabled(false) end
	return api
end


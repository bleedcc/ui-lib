function Window:IconAction() return nil end

function Window:SetUserScale(value) self.UserScale=math.clamp(tonumber(value) or 1,0.6,1.4) if self.Refit then self.Refit() end return self.UserScale end
function Window:SetOpacity(alpha) self.Opacity=math.clamp(tonumber(alpha) or 1,0.2,1) self.Main.BackgroundTransparency=1-self.Opacity return self.Opacity end
function Window:SetSize(w,h) self.Width=math.max(w,self.MinWidth) self.Height=math.max(h,self.MinHeight) self.Main.Size=UDim2.fromOffset(self.Width,self.Height) if self.Refit then self.Refit() end end

function Window:SetVisible(state)
	self.Visible=state
	if state then
		self.Main.Visible=true
		self.Scale.Scale=self.BaseScale*0.97
		Tween(self.Scale,{Scale=self.BaseScale},EASE_FAST)
	else
		self:CloseFloating()
		Tween(self.Scale,{Scale=self.BaseScale*0.97},EASE_FAST).Completed:Once(function()
			if not self.Visible then self.Main.Visible=false end
		end)
	end
end

-- ============================================================
-- Auto settings tab (deferred + detects existing settings tab)
-- ============================================================
function Library:_BuildAutoSettings(window)
	if not window then return end
	if window._SettingsBuilt then return end
	window._SettingsBuilt = true

	local SM = self.SaveManager
	local tab
	for _, t in ipairs(window.Tabs) do
		if t.Name == "settings" then tab = t break end
	end
	local autoCreated = false
	if not tab then
		tab = window:Tab("settings")
		autoCreated = true
	end

	if autoCreated and SM then
		local configName = "default"
		local configs = tab:Section("configs", 1)
		configs:Search({ Placeholder = "config name", Label = "name", Live = true, Callback = function(t) configName = t end })
		local dropdown
		dropdown = configs:Dropdown({ Text = "saved configs", Options = { "" }, Default = "", Callback = function(v) if v and v ~= "" then configName = v end end })
		local function refresh()
			local list = SM:List()
			if #list == 0 then list = { "" } end
			pcall(function() dropdown:SetOptions(list) end)
		end
		refresh()
		configs:ButtonRow({
			{ Text = "create", Callback = function()
				if not configName or configName == "" then self:Warn("config", "enter a name first", 3) return end
				if SM:Save(configName) then refresh() self:Success("config", "saved " .. configName, 3) else self:Error("config", "failed", 4) end
			end },
			{ Text = "load", Callback = function()
				if not configName or configName == "" then self:Warn("config", "enter a name first", 3) return end
				if SM:Load(configName) then self:Success("config", "loaded " .. configName, 3) else self:Error("config", "failed", 4) end
			end },
		})
		configs:ButtonRow({
			{ Text = "delete", Callback = function()
				if not configName or configName == "" then return end
				SM:Delete(configName) refresh() self:Success("config", "deleted", 3)
			end },
			{ Text = "autoload", Callback = function()
				if not configName or configName == "" then return end
				SM:SetAutoloadConfig(configName) self:Success("config", "autoload set", 3)
			end },
		})

		local pickers = {}
		local function addThemePicker(section, key, label)
			local picker = section:ColorPicker({
				Text = label, Flag = false, Default = self.Theme[key], Alpha = false,
				Callback = function(color, alpha) self:SetColor(key, color, alpha) end,
			})
			local flag = "theme_" .. string.lower(key)
			self.Flags[flag] = ToHex(self.Theme[key], 1)
			self:Register(flag, {
				Type = "ThemeColor",
				Get = function()
					local c = self.Theme[key]
					if typeof(c) ~= "Color3" then return "#FFFFFFFF" end
					return ToHex(c, 1)
				end,
				Set = function(v)
					local parsed, a = FromHex(v)
					if not parsed then return end
					self:SetColor(key, parsed, a or 1)
					self.Flags[flag] = ToHex(parsed, a or 1)
					if picker.Set then pcall(function() picker:Set(parsed, nil, true) end) end
				end,
			})
			pickers[key] = picker
		end

		local surfaces = tab:Section("theme surfaces", 1)
		for _, k in ipairs({"Window","WindowBorder","TopBar","Section","SectionBorder","Field","FieldHover","Border","BorderSoft","PopupBg","PopupBorder","Track","Text","TextDim","TextBright"}) do
			addThemePicker(surfaces, k, string.lower(k))
		end
		local accent = tab:Section("theme accent", 2)
		for _, k in ipairs({"Accent","AccentSoft","AccentDim","Danger","TextMarked","TextCode"}) do
			addThemePicker(accent, k, string.lower(k))
		end
		local notify = tab:Section("notifications", 2)
		notify:ButtonRow({
			{ Text = "normal", Callback = function() self:Notify("test", "notification", 3) end },
			{ Text = "warning", Callback = function() self:Warn("test", "warning", 3) end },
		})
		notify:ButtonRow({
			{ Text = "danger", Callback = function() self:Error("test", "error", 3) end },
			{ Text = "success", Callback = function() self:Success("test", "success", 3) end },
		})

		self:OnRepaint(function()
			for key, picker in pairs(pickers) do
				local target = self.Theme[key]
				if typeof(target) == "Color3" and picker.Get then
					local ok, c = pcall(picker.Get, picker)
					if ok and typeof(c) == "Color3" and c ~= target then
						pcall(function() picker:Set(target, nil, true) end)
					end
				end
			end
		end)
	end

	local hotkeys = tab:Section("hotkeys", 2)
	hotkeys:Toggle({
		Text = "show keybind list",
		Flag = "ui_hotkeys_visible",
		Default = true,
		Callback = function(on) Library:SetHotkeysVisible(on) end,
	})

	return tab
end

function Library:Window(opts)
	opts=opts or {}
	local width=opts.Width or 620
	local height=opts.Height or 560
	local gui=New("ScreenGui",{Name=opts.Name or "Facility",ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,AutoLocalize=false,IgnoreGuiInset=true,DisplayOrder=999})
	ParentGui(gui)
	local main=New("Frame",{Size=UDim2.fromOffset(width,height),Position=opts.Position or UDim2.fromScale(0.5,0.5),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=Theme.Window,BackgroundTransparency=Theme.WindowAlpha,BorderSizePixel=0,Parent=gui})
	Corner(main,10)
	Stroke(main,Theme.WindowBorder)
	local scale=New("UIScale",{Parent=main})
	local topBar=New("Frame",{Size=UDim2.new(1,0,0,46),BackgroundColor3=Theme.TopBar,BorderSizePixel=0,Parent=main})
	Corner(topBar,10)
	New("Frame",{Size=UDim2.new(1,0,0,12),Position=UDim2.new(0,0,1,-12),BackgroundColor3=Theme.TopBar,BorderSizePixel=0,Parent=topBar})
	local title=New("Frame",{Size=UDim2.new(0,0,1,0),Position=UDim2.fromOffset(16,0),AutomaticSize=Enum.AutomaticSize.X,BackgroundTransparency=1,Parent=topBar})
	local titleList=List(title,0,Enum.FillDirection.Horizontal)
	titleList.VerticalAlignment=Enum.VerticalAlignment.Center
	local titleName=Label(title,opts.Title or "facility",Theme.TextBright,14,Theme.FontMedium)
	titleName.Size=UDim2.new(0,0,1,0)
	titleName.AutomaticSize=Enum.AutomaticSize.X
	local titleSuffix=Label(title,opts.Suffix or ".app",Theme.Accent,14,Theme.FontMedium)
	titleSuffix.Size=UDim2.new(0,0,1,0)
	titleSuffix.AutomaticSize=Enum.AutomaticSize.X
	titleSuffix.LayoutOrder=2
	local titleDivider=New("Frame",{Size=UDim2.fromOffset(1,14),AnchorPoint=Vector2.new(0,0.5),BackgroundColor3=Theme.Border,BorderSizePixel=0,Parent=topBar})
	local tabStyle=(opts.TabStyle=="side" or opts.CategoryMod==2) and "side" or "top"
	local tabWidth=opts.TabWidth or 140
	local tabBar
	local layoutTabs
	if tabStyle=="side" then
		titleDivider.Visible=false
		tabBar=New("ScrollingFrame",{Size=UDim2.new(0,tabWidth,1,-(47+22)),Position=UDim2.fromOffset(14,58),BackgroundTransparency=1,BorderSizePixel=0,ClipsDescendants=true,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollingDirection=Enum.ScrollingDirection.Y,ScrollBarThickness=0,ElasticBehavior=Enum.ElasticBehavior.Never,Parent=main})
		List(tabBar,4)
		layoutTabs=function() end
	else
		tabBar=New("ScrollingFrame",{Size=UDim2.new(1,-180,1,0),Position=UDim2.fromOffset(0,0),BackgroundTransparency=1,BorderSizePixel=0,ClipsDescendants=true,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.X,ScrollingDirection=Enum.ScrollingDirection.X,ScrollBarThickness=0,ElasticBehavior=Enum.ElasticBehavior.Never,Parent=topBar})
		local tabList=List(tabBar,18,Enum.FillDirection.Horizontal)
		tabList.VerticalAlignment=Enum.VerticalAlignment.Center
		layoutTabs=function()
			local s=math.max(scale.Scale,0.05)
			local w=title.AbsoluteSize.X/s
			titleDivider.Position=UDim2.new(0,16+w+12,0.5,0)
			local x=16+w+25
			tabBar.Position=UDim2.fromOffset(x,0)
			tabBar.Size=UDim2.new(1,-(x+14),1,0)
		end
	end
	Track(title:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutTabs))
	Track(main:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutTabs))
	layoutTabs()
	New("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,0,46),BackgroundColor3=Theme.BorderSoft,BorderSizePixel=0,Parent=main})
	local shellLeft=tabStyle=="side" and (14+tabWidth+10) or 14
	local shell=New("Frame",{Size=UDim2.new(1,-(14+shellLeft),1,-(47+22)),Position=UDim2.fromOffset(shellLeft,58),BackgroundTransparency=1,BorderSizePixel=0,Parent=main})
	Corner(shell,8)
	Stroke(shell,Theme.SectionBorder)
	local body=New("Frame",{Size=UDim2.new(1,-24,1,-24),Position=UDim2.fromOffset(12,12),BackgroundTransparency=1,ClipsDescendants=true,Parent=shell})
	local overlay=New("Frame",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=300,Parent=main})
	local blocker=New("TextButton",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,AutoButtonColor=false,Text="",Visible=false,ZIndex=110,Parent=overlay})
	local window=setmetatable({
		Gui=gui,Main=main,TopBar=topBar,TabBar=tabBar,Body=body,Footer=nil,FooterLeft=nil,
		Overlay=overlay,Blocker=blocker,Scale=scale,TabStyle=tabStyle,TabWidth=tabWidth,BaseScale=1,
		FloatStack={},UserScale=1,Opacity=1-Theme.WindowAlpha,Width=width,Height=height,
		MinWidth=opts.MinWidth or 460,MinHeight=opts.MinHeight or 320,Tabs={},Visible=true,
	},Window)
	Track(blocker.Activated:Connect(function() window:CloseFloating() end))
	local function fit()
		local vp=gui.AbsoluteSize
		if vp.X<=0 then return end
		local s=math.clamp(math.min((vp.X-24)/window.Width,(vp.Y-24)/window.Height),0.55,1)*(window.UserScale or 1)
		window.BaseScale=s
		if window.Visible then scale.Scale=s end
	end
	window.Refit=fit
	Track(gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit))
	fit()
	local dragging,dragStart,startPos,moveConn,endConn
	Track(topBar.InputBegan:Connect(function(input)
		if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
		dragging=true
		dragStart=input.Position
		startPos=main.Position
		window:CloseFloating()
		moveConn=UserInputService.InputChanged:Connect(function(move)
			if not dragging then return end
			if move.UserInputType==Enum.UserInputType.MouseMovement or move.UserInputType==Enum.UserInputType.Touch then
				local delta=move.Position-dragStart
				main.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
			end
		end)
		endConn=UserInputService.InputEnded:Connect(function(ended)
			if ended.UserInputType==input.UserInputType then
				dragging=false
				if moveConn then moveConn:Disconnect() moveConn=nil end
				if endConn then endConn:Disconnect() endConn=nil end
			end
		end)
	end))
	local grip=New("TextButton",{Size=UDim2.fromOffset(16,16),AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-4,1,-4),BackgroundTransparency=1,AutoButtonColor=false,Text="",ClipsDescendants=true,ZIndex=130,Parent=main})
	local gripBars={}
	for i,d in ipairs({3,7,11}) do
		local bar=New("Frame",{Size=UDim2.fromOffset(d*2,2),AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromOffset(16-d,16-d),Rotation=-45,BackgroundColor3=Theme.Border,BorderSizePixel=0,ZIndex=130,Parent=grip})
		Corner(bar,1)
		gripBars[i]=bar
	end
	Track(grip.MouseEnter:Connect(function()
		for _,bar in ipairs(gripBars) do Tween(bar,{BackgroundColor3=Theme.Accent},EASE_FAST) end
	end))
	Track(grip.MouseLeave:Connect(function()
		if window.Resizing then return end
		for _,bar in ipairs(gripBars) do Tween(bar,{BackgroundColor3=Theme.Border},EASE_FAST) end
	end))
	local resizeMove,resizeEnd
	Track(grip.InputBegan:Connect(function(input)
		if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
		window.Resizing=true
		window:CloseFloating()
		local origin=input.Position
		local startW,startH=window.Width,window.Height
		local startPos=main.Position
		resizeMove=UserInputService.InputChanged:Connect(function(move)
			if not window.Resizing then return end
			if move.UserInputType~=Enum.UserInputType.MouseMovement and move.UserInputType~=Enum.UserInputType.Touch then return end
			local s=math.max(scale.Scale,0.05)
			local vp=gui.AbsoluteSize
			local delta=move.Position-origin
			local w=math.clamp(startW+delta.X/s,window.MinWidth,math.max(window.MinWidth,vp.X-24))
			local h=math.clamp(startH+delta.Y/s,window.MinHeight,math.max(window.MinHeight,vp.Y-24))
			window:SetSize(w,h)
			main.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+(w-startW)*0.5,startPos.Y.Scale,startPos.Y.Offset+(h-startH)*0.5)
		end)
		resizeEnd=UserInputService.InputEnded:Connect(function(ended)
			if ended.UserInputType~=input.UserInputType then return end
			window.Resizing=false
			for _,bar in ipairs(gripBars) do Tween(bar,{BackgroundColor3=Theme.Border},EASE_FAST) end
			if resizeMove then resizeMove:Disconnect() resizeMove=nil end
			if resizeEnd then resizeEnd:Disconnect() resizeEnd=nil end
		end)
	end))
	if opts.Cursor then Library:SetCursor(true,type(opts.Cursor)=="table" and opts.Cursor or nil) end
	if opts.MobileButton==true or (opts.MobileButton~=false and UserInputService.TouchEnabled) then
		Library:CreateMobileButton(opts.MobileButtonOptions)
	end
	table.insert(Library.Windows,window)
	-- Defer so setup script tabs are all created BEFORE auto-settings fires.
	if opts.SettingsTab~=false then
		task.defer(function()
			local ok,err=pcall(function() Library:_BuildAutoSettings(window) end)
			if not ok then warn("Facility | auto settings tab failed: "..tostring(err)) end
		end)
	end
	return window
end

function Library:Notify(opts,text,duration)
	if self.NotificationsEnabled==false then return end
	if type(opts)=="string" then opts={Title=opts,Text=text,Duration=duration} end
	opts=opts or {}
	opts.Text=opts.Text or opts.Content or opts.Description
	local styled=opts.Color~=nil or (type(opts.Style)=="string" and string.lower(opts.Style)~="normal")
	local accent=opts.Color or StyleColor(opts.Style,Theme.Accent)
	local iconName=opts.Icon
	if iconName==nil and type(opts.Style)=="string" then
		local k=string.lower(opts.Style)
		if k=="warning" or k=="warn" or k=="yellow" then iconName="alert-triangle"
		elseif k=="danger" or k=="error" or k=="red" then iconName="x-circle"
		elseif k=="success" or k=="green" then iconName="check-circle" end
	end
	if not self.NotifyGui then
		local gui=New("ScreenGui",{Name="FacilityNotifications",ResetOnSpawn=false,IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,AutoLocalize=false,DisplayOrder=1000})
		ParentGui(gui)
		local holder=New("Frame",{Size=UDim2.fromOffset(260,400),AnchorPoint=Vector2.new(0,0),Position=UDim2.fromOffset(18,18),BackgroundTransparency=1,Parent=gui})
		local l=List(holder,8)
		l.VerticalAlignment=Enum.VerticalAlignment.Top
		l.HorizontalAlignment=Enum.HorizontalAlignment.Left
		self.NotifyGui=gui
		self.NotifyHolder=holder
	end
	local limit=self.NotificationLimit or 5
	local live={}
	for _,child in ipairs(self.NotifyHolder:GetChildren()) do if child:IsA("Frame") then table.insert(live,child) end end
	for index=1,#live-(limit-1) do pcall(function() live[index]:Destroy() end) end
	local card=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=Theme.Section,BackgroundTransparency=1,BorderSizePixel=0,Parent=self.NotifyHolder})
	Corner(card,6)
	local cStroke=Stroke(card,Theme.SectionBorder,1,1)
	local bar=New("Frame",{Size=UDim2.new(0,12,1,0),BackgroundColor3=accent,BackgroundTransparency=1,BorderSizePixel=0,Parent=card})
	Corner(bar,6)
	local barCover=New("Frame",{Size=UDim2.new(0,9,1,0),Position=UDim2.fromOffset(3,0),BackgroundColor3=Theme.Section,BackgroundTransparency=1,BorderSizePixel=0,Parent=card})
	local inner=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=card})
	Pad(inner,10,12,10,14)
	List(inner,3)
	local headRow=New("Frame",{Size=UDim2.new(1,0,0,16),BackgroundTransparency=1,Parent=inner})
	local icon=AttachIcon(headRow,iconName,accent,14)
	if icon then icon.ImageTransparency=1 end
	local inset=icon and 19 or 0
	local head=Label(headRow,opts.Title or "notice",styled and accent or Theme.TextBright,13,Theme.FontMedium)
	head.Position=UDim2.fromOffset(inset,0)
	head.Size=UDim2.new(1,-inset,1,0)
	head.TextTransparency=1
	local textLbl
	if opts.Text then
		textLbl=Label(inner,opts.Text,Theme.Text,12)
		textLbl.Size=UDim2.new(1,0,0,0)
		textLbl.AutomaticSize=Enum.AutomaticSize.Y
		textLbl.TextWrapped=true
		textLbl.LayoutOrder=2
		textLbl.TextTransparency=1
	end
	card.Position=UDim2.fromOffset(-20,0)
	Tween(card,{BackgroundTransparency=0,Position=UDim2.fromOffset(0,0)})
	Tween(cStroke,{Transparency=0})
	Tween(bar,{BackgroundTransparency=0})
	Tween(barCover,{BackgroundTransparency=0})
	Tween(head,{TextTransparency=0})
	if icon then Tween(icon,{ImageTransparency=0}) end
	if textLbl then Tween(textLbl,{TextTransparency=0}) end
	task.delay(opts.Duration or 3.5,function()
		if not card.Parent then return end
		Tween(card,{BackgroundTransparency=1,Position=UDim2.fromOffset(-20,0)})
		Tween(cStroke,{Transparency=1})
		Tween(bar,{BackgroundTransparency=1})
		Tween(barCover,{BackgroundTransparency=1})
		Tween(head,{TextTransparency=1})
		if icon then Tween(icon,{ImageTransparency=1}) end
		if textLbl then Tween(textLbl,{TextTransparency=1}) end
		task.wait(0.22)
		card:Destroy()
	end)
end

function Library:Warn(title,text,duration) return self:Notify({Title=title,Text=text,Style="warning",Duration=duration}) end
function Library:Error(title,text,duration) return self:Notify({Title=title,Text=text,Style="danger",Duration=duration}) end
function Library:Success(title,text,duration) return self:Notify({Title=title,Text=text,Style="success",Duration=duration}) end

local MOUSE_KEYS={MB1=Enum.UserInputType.MouseButton1,MB2=Enum.UserInputType.MouseButton2,MB3=Enum.UserInputType.MouseButton3}

function Library:SetToggleKey(key)
	self.ToggleKey=nil
	self.ToggleInput=nil
	if typeof(key)=="EnumItem" then
		if key.EnumType==Enum.UserInputType then self.ToggleInput=key else self.ToggleKey=key end
	elseif type(key)=="string" then
		if MOUSE_KEYS[key] then self.ToggleInput=MOUSE_KEYS[key]
		else
			local ok,code=pcall(function() return Enum.KeyCode[key] end)
			self.ToggleKey=ok and code or nil
		end
	end
	return self.ToggleKey or self.ToggleInput
end

function Library:RegisterHotkey(getter) table.insert(self.HotkeyEntries,getter) self:RefreshHotkeys() return getter end

function Library:CreateHotkeyPanel(opts)
	if self.HotkeyGui then return self.HotkeyPanel end
	opts=opts or {}
	local gui=New("ScreenGui",{Name="FacilityHotkeys",ResetOnSpawn=false,IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,AutoLocalize=false,DisplayOrder=998,Enabled=false})
	ParentGui(gui)
	local panel=New("Frame",{Size=UDim2.fromOffset(opts.Width or 200,0),AutomaticSize=Enum.AutomaticSize.Y,Position=opts.Position or UDim2.new(1,-220,0,18),BackgroundColor3=Theme.Section,BackgroundTransparency=0.05,BorderSizePixel=0,Active=true,Parent=gui})
	Corner(panel,8)
	Stroke(panel,Theme.SectionBorder)
	local inner=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=panel})
	List(inner,0)
	local header=New("Frame",{Size=UDim2.new(1,0,0,30),BackgroundTransparency=1,Parent=inner})
	Pad(header,0,12,0,12)
	local hLabel=Label(header,opts.Title or "keybinds",Theme.TextBright,Theme.TextSize,Theme.FontMedium)
	hLabel.Size=UDim2.new(1,0,1,0)
	New("Frame",{Size=UDim2.new(1,0,0,1),BackgroundColor3=Theme.BorderSoft,BorderSizePixel=0,LayoutOrder=2,Parent=inner})
	local body=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,LayoutOrder=3,Parent=inner})
	Pad(body,8,12,10,12)
	local rows=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=body})
	List(rows,5)
	local origin,startPos,mc,ec
	Track(panel.InputBegan:Connect(function(input)
		if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
		origin=input.Position
		startPos=panel.Position
		mc=UserInputService.InputChanged:Connect(function(move)
			if move.UserInputType~=Enum.UserInputType.MouseMovement and move.UserInputType~=Enum.UserInputType.Touch then return end
			local delta=move.Position-origin
			panel.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
		end)
		ec=UserInputService.InputEnded:Connect(function(ended)
			if ended.UserInputType~=input.UserInputType then return end
			if mc then mc:Disconnect() mc=nil end
			if ec then ec:Disconnect() ec=nil end
		end)
	end))
	self.HotkeyGui=gui
	self.HotkeyPanel=panel
	self.HotkeyRows=rows
	return panel
end

function Library:RefreshHotkeys()
	if not self.HotkeyGui or not self.HotkeysEnabled then return end
	local rows=self.HotkeyRows
	for _,child in ipairs(rows:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
	local shown=0
	for index=#self.HotkeyEntries,1,-1 do
		local ok,data=pcall(self.HotkeyEntries[index])
		if not ok then table.remove(self.HotkeyEntries,index)
		elseif type(data)=="table" and data.Visible and data.Key and data.Key~="" then
			shown=shown+1
			local color=data.Active and Theme.Accent or Theme.TextDim
			local row=New("Frame",{Size=UDim2.new(1,0,0,16),BackgroundTransparency=1,LayoutOrder=shown,Parent=rows})
			local label=Label(row,data.Label or "action",color,Theme.TextSize-1)
			label.Size=UDim2.new(1,-52,1,0)
			label.TextTruncate=Enum.TextTruncate.AtEnd
			local key=Label(row,data.Key,color,Theme.TextSize-1)
			key.AnchorPoint=Vector2.new(1,0)
			key.Position=UDim2.fromScale(1,0)
			key.Size=UDim2.fromOffset(50,16)
			key.TextXAlignment=Enum.TextXAlignment.Right
		end
	end
	self.HotkeyPanel.Visible=shown>0
end

function Library:SetHotkeysVisible(state)
	if state==nil then state=not self.HotkeysEnabled end
	self.HotkeysEnabled=state and true or false
	if self.HotkeysEnabled then self:CreateHotkeyPanel() end
	if self.HotkeyGui then self.HotkeyGui.Enabled=self.HotkeysEnabled and self.Open end
	if self.HotkeysEnabled then self:RefreshHotkeys() end
	return self.HotkeysEnabled
end

function Library:CreateCursor(opts)
	if self.CursorGui then return self.CursorGui end
	opts=opts or {}
	local length=opts.Length or 9
	local thickness=opts.Thickness or 2
	local gap=opts.Gap or 4
	local gui=New("ScreenGui",{Name="FacilityCursor",ResetOnSpawn=false,IgnoreGuiInset=true,AutoLocalize=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,DisplayOrder=1002,Enabled=false})
	ParentGui(gui)
	local holder=New("Frame",{Size=UDim2.fromOffset(1,1),AnchorPoint=Vector2.new(0.5,0.5),BackgroundTransparency=1,Parent=gui})
	local function bar(anchor,position,size)
		local piece=New("Frame",{Size=size,AnchorPoint=anchor,Position=position,BackgroundColor3=opts.Color or Theme.Accent,BorderSizePixel=0,Parent=holder})
		Corner(piece,1)
		return piece
	end
	bar(Vector2.new(1,0.5),UDim2.new(0.5,-gap,0.5,0),UDim2.fromOffset(length,thickness))
	bar(Vector2.new(0,0.5),UDim2.new(0.5,gap,0.5,0),UDim2.fromOffset(length,thickness))
	bar(Vector2.new(0.5,1),UDim2.new(0.5,0,0.5,-gap),UDim2.fromOffset(thickness,length))
	bar(Vector2.new(0.5,0),UDim2.new(0.5,0,0.5,gap),UDim2.fromOffset(thickness,length))
	if opts.Dot~=false then bar(Vector2.new(0.5,0.5),UDim2.fromScale(0.5,0.5),UDim2.fromOffset(thickness,thickness)) end
	Track(RunService.RenderStepped:Connect(function()
		if not gui.Enabled then return end
		local pos=UserInputService:GetMouseLocation()
		if not gui.IgnoreGuiInset then pos=pos-GuiService:GetGuiInset() end
		holder.Position=UDim2.fromOffset(pos.X,pos.Y)
	end))
	self.CursorGui=gui
	self.CursorHolder=holder
	return gui
end

function Library:RefreshCursor() if not self.CursorGui then return end self.CursorGui.Enabled=self.CursorEnabled and self.Open end
function Library:SetCursor(state,opts)
	self.CursorEnabled=state and true or false
	if self.CursorEnabled then self:CreateCursor(opts) end
	self:RefreshCursor()
	return self.CursorEnabled
end

function Library:ToggleUI(state)
	if state==nil then state=not self.Open end
	self.Open=state
	for _,window in ipairs(self.Windows) do
		pcall(function() window:SetVisible(state) end)
	end
	if self.HotkeyGui then self.HotkeyGui.Enabled=self.HotkeysEnabled and self.Open end
	self:RefreshCursor()
	return self.Open
end

function Library:CreateMobileButton(opts)
	if self.MobileGui then return self.MobileButton end
	opts=opts or {}
	local gui=New("ScreenGui",{Name="FacilityToggle",ResetOnSpawn=false,IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,AutoLocalize=false,DisplayOrder=1001})
	ParentGui(gui)
	local button=New("TextButton",{Size=UDim2.fromOffset(opts.Size or 44,opts.Size or 44),Position=opts.Position or UDim2.new(0,18,0.5,-22),BackgroundColor3=Theme.Section,AutoButtonColor=false,Text="",BorderSizePixel=0,Parent=gui})
	Corner(button,12)
	Stroke(button,Theme.Border)
	for i=1,3 do
		local bar=New("Frame",{Size=UDim2.fromOffset(18,2),AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(0.5,0,0.5,(i-2)*6),BackgroundColor3=Theme.Accent,BorderSizePixel=0,Parent=button})
		Corner(bar,1)
	end
	local moved,origin,startPos,mc,ec
	Track(button.InputBegan:Connect(function(input)
		if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
		moved=false
		origin=input.Position
		startPos=button.Position
		if Library.Open then
			Tween(button,{BackgroundColor3=Theme.FieldHover},EASE_FAST)
			ec=UserInputService.InputEnded:Connect(function(ended)
				if ended.UserInputType~=input.UserInputType then return end
				if ec then ec:Disconnect() ec=nil end
				Tween(button,{BackgroundColor3=Theme.Section},EASE_FAST)
				if not moved then Library:ToggleUI() end
			end)
			return
		end
		Tween(button,{BackgroundColor3=Theme.FieldHover},EASE_FAST)
		mc=UserInputService.InputChanged:Connect(function(move)
			if move.UserInputType~=Enum.UserInputType.MouseMovement and move.UserInputType~=Enum.UserInputType.Touch then return end
			local delta=move.Position-origin
			if math.abs(delta.X)>6 or math.abs(delta.Y)>6 then moved=true end
			button.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
		end)
		ec=UserInputService.InputEnded:Connect(function(ended)
			if ended.UserInputType~=input.UserInputType then return end
			if mc then mc:Disconnect() mc=nil end
			if ec then ec:Disconnect() ec=nil end
			Tween(button,{BackgroundColor3=Theme.Section},EASE_FAST)
			if not moved then Library:ToggleUI() end
		end)
	end))
	self.MobileGui=gui
	self.MobileButton=button
	return button
end

function Library:SetMobileButtonVisible(state)
	if not self.MobileGui then
		if not state then return end
		self:CreateMobileButton()
	end
	self.MobileGui.Enabled=state and true or false
end

Track(UserInputService.InputBegan:Connect(function(input,gpe)
	if gpe or Library.Binding then return end
	local hit=(Library.ToggleKey~=nil and input.KeyCode==Library.ToggleKey)
		or (Library.ToggleInput~=nil and input.UserInputType==Library.ToggleInput)
	if hit then Library:ToggleUI() end
end))

function Library:Destroy()
	for _,conn in ipairs(self.Connections) do pcall(function() conn:Disconnect() end) end
	table.clear(self.Connections)
	for _,w in ipairs(self.Windows) do pcall(function() w.Gui:Destroy() end) end
	table.clear(self.Windows)
	if self.NotifyGui then pcall(function() self.NotifyGui:Destroy() end) self.NotifyGui=nil end
	if self.MobileGui then pcall(function() self.MobileGui:Destroy() end) self.MobileGui=nil self.MobileButton=nil end
	if self.CursorGui then pcall(function() self.CursorGui:Destroy() end) self.CursorGui=nil self.CursorHolder=nil end
	if self.HotkeyGui then pcall(function() self.HotkeyGui:Destroy() end) self.HotkeyGui=nil self.HotkeyPanel=nil end
	table.clear(self.HotkeyEntries)
	table.clear(self.Registry)
	table.clear(self.Flags)
end

local FileSystem={}
FileSystem.Memory={}
FileSystem.Native=typeof(writefile)=="function" and typeof(readfile)=="function"

function FileSystem:MakeFolder(path)
	if not self.Native then return end
	if typeof(makefolder)=="function" and typeof(isfolder)=="function" then
		local ok,exists=pcall(isfolder,path)
		if ok and not exists then pcall(makefolder,path) end
	end
end

function FileSystem:Write(path,text)
	if self.Native and pcall(writefile,path,text) then self.Memory[path]=nil return true end
	self.Memory[path]=text
	return true
end

function FileSystem:Read(path)
	if self.Native and typeof(isfile)=="function" then
		local ok,exists=pcall(isfile,path)
		if ok and exists then
			local read,data=pcall(readfile,path)
			if read then return data end
		end
	end
	return self.Memory[path]
end

function FileSystem:Delete(path)
	if self.Native and typeof(delfile)=="function" then pcall(delfile,path) end
	self.Memory[path]=nil
end

function FileSystem:List(folder)
	local names,seen={},{}
	if self.Native and typeof(listfiles)=="function" then
		local ok,files=pcall(listfiles,folder)
		if ok and files then
			for _,full in ipairs(files) do
				local name=string.match(full,"[^/\\]+$")
				if name and not seen[name] then seen[name]=true table.insert(names,name) end
			end
		end
	end
	for path in pairs(self.Memory) do
		if string.sub(path,1,#folder+1)==folder.."/" then
			local name=string.match(path,"[^/\\]+$")
			if name and not seen[name] then seen[name]=true table.insert(names,name) end
		end
	end
	table.sort(names)
	return names
end

function Library:BuildFolders(folder)
	local path=""
	for _,part in ipairs(string.split(folder,"/")) do
		path=path=="" and part or (path.."/"..part)
		FileSystem:MakeFolder(path)
	end
	FileSystem:MakeFolder(folder.."/configs")
	FileSystem:MakeFolder(folder.."/settings")
	return folder
end

Library.FileSystem=FileSystem

local SaveManager={}
local SM={Library=Library,Folder="Facility",Ignore={},AutoloadFile="autoload.txt"}
local SM_FS=Library.FileSystem

function SaveManager:SetLibrary(lib) SM.Library=lib end
function SaveManager:SetFolder(folder) SM.Folder=folder Library:BuildFolders(folder) end
function SaveManager:SetIgnoreIndexes(list) SM.Ignore=list or {} end
function SaveManager:IgnoreThemeSettings() end
function SaveManager:GetConfigPath(name) return SM.Folder.."/configs/"..tostring(name)..".json" end
function SaveManager:GetAutoloadPath() return SM.Folder.."/settings/"..SM.AutoloadFile end

function SaveManager:Save(name)
	if not name or name=="" then return false end
	local data=SM.Library:GetConfig(SM.Ignore)
	local ok,encoded=pcall(function() return game:GetService("HttpService"):JSONEncode(data) end)
	if not ok then return false end
	Library:BuildFolders(SM.Folder)
	Library:BuildFolders(SM.Folder.."/configs")
	SM_FS:Write(self:GetConfigPath(name),encoded)
	return true
end

function SaveManager:Load(name)
	if not name or name=="" then return false end
	local raw=SM_FS:Read(self:GetConfigPath(name))
	if not raw then return false end
	local ok,data=pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
	if not ok or type(data)~="table" then return false end
	SM.Library:LoadConfig(data,SM.Ignore)
	return true
end

function SaveManager:Delete(name)
	if not name or name=="" then return false end
	SM_FS:Delete(self:GetConfigPath(name))
	return true
end

function SaveManager:List()
	local files=SM_FS:List(SM.Folder.."/configs")
	local out={}
	for _,f in ipairs(files) do
		local name=string.match(f,"^(.+)%.json$")
		if name then table.insert(out,name) end
	end
	table.sort(out)
	return out
end

function SaveManager:RefreshConfigList() end
function SaveManager:GetConfigList() return self:List() end

function SaveManager:SetAutoloadConfig(name)
	Library:BuildFolders(SM.Folder)
	Library:BuildFolders(SM.Folder.."/settings")
	SM_FS:Write(self:GetAutoloadPath(),tostring(name or ""))
	return true
end

function SaveManager:GetAutoload()
	local raw=SM_FS:Read(self:GetAutoloadPath())
	if not raw or raw=="" then return nil end
	return raw
end

function SaveManager:ClearAutoload() return self:SetAutoloadConfig("") end

function SaveManager:LoadAutoloadConfig()
	local name=self:GetAutoload()
	if not name or name=="" then return false end
	return self:Load(name)
end

Library.SaveManager=SaveManager

if getgenv then pcall(function() getgenv().Facility=Library end) end

Library.InterfaceManager=Library:LoadAddon("InterfaceManager")
Library.ThemeManager=Library:LoadAddon("ThemeManager")

return Library

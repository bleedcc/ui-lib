function Window:CreateFloating(width,matchAnchor,parent)
	local depth=parent and (parent.Depth+1) or 1
	local z=118+depth*4
	local frame=New("Frame",{Size=UDim2.fromOffset(width>0 and width or 160,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=Theme.PopupBg,BorderSizePixel=0,Visible=false,Active=true,ZIndex=z,Parent=self.Overlay})
	Corner(frame,5)
	Stroke(frame,matchAnchor and Theme.Accent or Theme.PopupBorder)
	Pad(frame,6)
	local content=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,ZIndex=z,Parent=frame})
	List(content,6)
	return {Frame=frame,Content=content,MatchAnchor=matchAnchor,Parent=parent,Depth=depth}
end

function Window:CloseFloatingFrom(depth)
	local stack=self.FloatStack
	while #stack>0 and stack[#stack].Depth>=depth do
		local panel=table.remove(stack)
		panel.Frame.Visible=false
		if panel.OnClose then panel.OnClose() end
	end
	self.Blocker.Visible=#stack>0
end
function Window:CloseFloating() self:CloseFloatingFrom(1) end

function Window:ToggleFloating(panel,anchor,matchWidth)
	for _,open in ipairs(self.FloatStack) do
		if open==panel then self:CloseFloatingFrom(panel.Depth) return end
	end
	self:CloseFloatingFrom(panel.Depth)
	local scale=self.Scale.Scale
	local ox=(anchor.AbsolutePosition.X-self.Main.AbsolutePosition.X)/scale
	local oy=(anchor.AbsolutePosition.Y-self.Main.AbsolutePosition.Y)/scale
	local h=anchor.AbsoluteSize.Y/scale
	if matchWidth then panel.Frame.Size=UDim2.fromOffset(anchor.AbsoluteSize.X/scale,0) end
	panel.Frame.Position=UDim2.fromOffset(ox,oy+h+4)
	panel.Frame.Visible=true
	table.insert(self.FloatStack,panel)
	self.Blocker.Visible=true
	if panel.OnOpen then panel.OnOpen() end
	local target=panel.Frame.Position
	panel.Frame.Position=target-UDim2.fromOffset(0,4)
	Tween(panel.Frame,{Position=target},EASE_FAST)
end

function Window:Tab(name,icon)
	local opts=type(name)=="table" and name or {Title=name,Icon=icon}
	local title=opts.Title or opts.Text or "tab"
	local page=New("ScrollingFrame",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollBarThickness=3,ScrollBarImageColor3=Theme.AccentDim,VerticalScrollBarInset=Enum.ScrollBarInset.None,Visible=false,Parent=self.Body})
	local pageList=List(page,14)
	pageList.SortOrder=Enum.SortOrder.LayoutOrder
	Pad(page,2,8,2,8)
	local tab=setmetatable({Window=self,Page=page,Columns={},Name=title,Order=0},Tab)
	local side=self.TabStyle=="side"
	local button=New("TextButton",{Size=side and UDim2.new(1,0,0,30) or UDim2.new(0,0,1,0),AutomaticSize=(not side) and Enum.AutomaticSize.X or Enum.AutomaticSize.None,BackgroundColor3=Theme.Field,BackgroundTransparency=1,AutoButtonColor=false,Text="",LayoutOrder=self:NextTabOrder(),Parent=self.TabBar})
	if side then Corner(button,5) end
	local row=New("Frame",{Size=side and UDim2.new(1,-20,1,0) or UDim2.new(0,0,1,0),Position=side and UDim2.fromOffset(10,0) or UDim2.fromOffset(0,0),AutomaticSize=(not side) and Enum.AutomaticSize.X or Enum.AutomaticSize.None,BackgroundTransparency=1,Parent=button})
	local rowList=List(row,7,Enum.FillDirection.Horizontal)
	rowList.VerticalAlignment=Enum.VerticalAlignment.Center
	local icon=AttachIcon(row,opts.Icon,Theme.TextDim,15)
	if icon then icon.Position=UDim2.fromOffset(0,0) icon.LayoutOrder=1 end
	local label=Label(row,title,Theme.TextDim,Theme.TextSize+1)
	label.Size=side and UDim2.new(1,icon and -22 or 0,1,0) or UDim2.new(0,0,1,0)
	label.AutomaticSize=(not side) and Enum.AutomaticSize.X or Enum.AutomaticSize.None
	label.TextTruncate=Enum.TextTruncate.AtEnd
	label.LayoutOrder=2
	tab.Button=button
	tab.Label=label
	tab.Icon=icon
	function tab:SetActive(active,animate)
		local info=animate and EASE_FAST or TweenInfo.new(0)
		local color=active and Theme.Accent or Theme.TextDim
		Tween(label,{TextColor3=color},info)
		if icon then Tween(icon,{ImageColor3=color},info) end
		if side then Tween(button,{BackgroundTransparency=active and 0 or 1},info) end
	end
	table.insert(self.Tabs,tab)
	Library:OnRepaint(function() tab:SetActive(self.ActiveTab==tab,false) end)
	Track(button.Activated:Connect(function() self:SetTab(tab) end))
	Track(button.MouseEnter:Connect(function()
		if self.ActiveTab==tab then return end
		Tween(label,{TextColor3=Theme.Text},EASE_FAST)
		if icon then Tween(icon,{ImageColor3=Theme.Text},EASE_FAST) end
		if side then Tween(button,{BackgroundTransparency=0.55},EASE_FAST) end
	end))
	Track(button.MouseLeave:Connect(function()
		if self.ActiveTab==tab then return end
		Tween(label,{TextColor3=Theme.TextDim},EASE_FAST)
		if icon then Tween(icon,{ImageColor3=Theme.TextDim},EASE_FAST) end
		if side then Tween(button,{BackgroundTransparency=1},EASE_FAST) end
	end))
	Track(page:GetPropertyChangedSignal("CanvasPosition"):Connect(function() self:CloseFloating() end))
	if not self.ActiveTab then self:SetTab(tab) end
	return tab
end

function Window:NextTabOrder() self.TabOrder=(self.TabOrder or 0)+1 return self.TabOrder end

function Window:SetTab(tab)
	if type(tab)=="string" then
		for _,t in ipairs(self.Tabs) do if t.Name==tab then tab=t break end end
	end
	if self.ActiveTab==tab then return end
	self:CloseFloating()
	if self.ActiveTab then self.ActiveTab.Page.Visible=false self.ActiveTab:SetActive(false,true) end
	self.ActiveTab=tab
	tab.Page.Visible=true
	tab.Page.Position=UDim2.fromOffset(0,6)
	Tween(tab.Page,{Position=UDim2.fromOffset(0,0)})
	tab:SetActive(true,true)
end


local function CreateSection(window,parent,title,order)
	local frame=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=Theme.Section,BorderSizePixel=0,LayoutOrder=order,Parent=parent})
	Corner(frame,7)
	Stroke(frame,Theme.SectionBorder)
	Pad(frame,12,14,14,14)
	List(frame,0)
	local header=New("TextButton",{Size=UDim2.new(1,0,0,22),BackgroundTransparency=1,AutoButtonColor=false,Text="",Parent=frame})
	local htitle=Label(header,title,Theme.TextBright,Theme.TextSize+1,Theme.FontMedium)
	htitle.Size=UDim2.new(1,-16,1,0)
	local hchev=Chevron(header,Theme.TextDim)
	hchev.AnchorPoint=Vector2.new(0,0.5)
	hchev.Position=UDim2.new(0,htitle.TextBounds.X+6,0.5,1)
	Track(htitle:GetPropertyChangedSignal("TextBounds"):Connect(function()
		hchev.Position=UDim2.new(0,htitle.TextBounds.X+6,0.5,1)
	end))
	local body=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,ClipsDescendants=false,LayoutOrder=2,Parent=frame})
	local content=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=body})
	List(content,9)
	Pad(content,6,0,0,0)
	local self=setmetatable(NewContainer(window,content),Section)
	self.Frame=frame
	self.Open=true
	Track(header.Activated:Connect(function()
		self.Open=not self.Open
		body.ClipsDescendants=true
		if self.Open then
			body.Visible=true
			body.Size=UDim2.new(1,0,0,0)
			local target=content.AbsoluteSize.Y/window.Scale.Scale
			Tween(body,{Size=UDim2.new(1,0,0,target)}).Completed:Once(function()
				if self.Open then body.AutomaticSize=Enum.AutomaticSize.Y body.ClipsDescendants=false end
			end)
			Tween(hchev,{Rotation=0},EASE_FAST)
		else
			local current=body.AbsoluteSize.Y/window.Scale.Scale
			body.AutomaticSize=Enum.AutomaticSize.None
			body.Size=UDim2.new(1,0,0,current)
			Tween(body,{Size=UDim2.new(1,0,0,0)}).Completed:Once(function()
				if not self.Open then body.Visible=false end
			end)
			Tween(hchev,{Rotation=180},EASE_FAST)
		end
		window:CloseFloating()
	end))
	Track(header.MouseEnter:Connect(function() Tween(htitle,{TextColor3=Theme.AccentSoft},EASE_FAST) end))
	Track(header.MouseLeave:Connect(function() Tween(htitle,{TextColor3=Theme.TextBright},EASE_FAST) end))
	return self
end


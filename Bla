function Library:Repaint()
	IndexTheme()
	for i=#Painted,1,-1 do
		local entry=Painted[i]
		local ok=pcall(function()
			local inst,prop,key=entry[1],entry[2],entry[3]
			inst[prop]=Theme[key]
			local a=ThemeAlpha[key]
			local tp=ALPHA_PROPS[prop]
			if a and tp and inst[tp]<1 then inst[tp]=1-a end
		end)
		if not ok then table.remove(Painted,i) end
	end
	self:RefreshHotkeys()
	for i=#self.RepaintHooks,1,-1 do
		local ok=pcall(self.RepaintHooks[i])
		if not ok then table.remove(self.RepaintHooks,i) end
	end
end

function Library:Register(flag,entry) self.Registry[flag]=entry self.Defaults[flag]=entry.Get() end
function Library:MarkDirty(flag) if flag and self.DirtyIgnore and self.DirtyIgnore[flag] then return end if self.Dirty then return end self.Dirty=true if self.OnDirty then task.spawn(self.OnDirty,true) end end
function Library:ClearDirty() self.Dirty=false if self.OnDirty then task.spawn(self.OnDirty,false) end end

function Library:GetConfig(ignore)
	local data={}
	for flag,entry in pairs(self.Registry) do
		if not (ignore and ignore[flag]) then local ok,v=pcall(entry.Get) if ok then data[flag]=v end end
	end
	return data
end

function Library:LoadConfig(data,ignore)
	for flag,value in pairs(data or {}) do
		local entry=self.Registry[flag]
		if entry and not (ignore and ignore[flag]) then pcall(entry.Set,value) end
	end
	self:ClearDirty()
end

function Library:CaptureDefaults() for f,e in pairs(self.Registry) do local ok,v=pcall(e.Get) if ok then self.Defaults[f]=v end end end
function Library:ResetDefaults(ig) self:LoadConfig(self.Defaults,ig) end

